 class Solution {
     public boolean containsDuplicate(int[] nums) {
        HashSet<Integer> ans= new Hashset<>();
        HashSet<Integer> ans = new HashSet<>();
        for(int i=0;i<nums.length;i++){
            ans.add(nums[i]);
        }
        if(ans.size()<nums.length){
            return true;
        }
        return false;
    }
}



class Solution {
    public boolean containsDuplicate(int[] nums) {
        for(int i=0;i<nums.length;i++){
            for(int j=i+1;j<nums.length;j++){
                if(nums[i]==nums[j]){
                    return true ;
                }
            }
        }
        return false;
    }
}
